---
import Base from '@/layouts/Base.astro';

// Distribuição via GitHub Releases (resolve o limite de 25 MB do Cloudflare Pages).
const REPO = 'caioross/AulaLogger';
const releasesUrl = `https://github.com/${REPO}/releases`;
const latestPageUrl = `${releasesUrl}/latest`;

type Release = {
  version: string | null;
  date: string | null;
  apkUrl: string | null;
  apkSize: string | null;
  prerelease: boolean;
};

let rel: Release = {
  version: null,
  date: null,
  apkUrl: null,
  apkSize: null,
  prerelease: false,
};

// No momento do build, descobre a release mais recente e o nome do APK anexado.
// O link usa o redirect "releases/latest/download/<arquivo>", que o GitHub
// resolve sempre para a release mais nova — não fica desatualizado entre builds.
try {
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
    headers: {
      Accept: 'application/vnd.github+json',
      'User-Agent': 'aulalogger-site',
    },
  });
  if (res.ok) {
    const data = await res.json();
    const apk = (data.assets ?? []).find((a: any) =>
      a?.name?.toLowerCase().endsWith('.apk'),
    );
    rel = {
      version: data.tag_name ?? null,
      date: data.published_at
        ? new Date(data.published_at).toLocaleDateString('pt-BR')
        : null,
      apkUrl: apk ? `${latestPageUrl}/download/${apk.name}` : null,
      apkSize: apk?.size
        ? `${(apk.size / (1024 * 1024)).toFixed(0)} MB`
        : null,
      prerelease: Boolean(data.prerelease),
    };
  }
} catch {
  // Sem release publicada (ou API indisponível): cai no botão da página de releases.
}

const hasDirect = Boolean(rel.apkUrl);
const latestVersion = rel.version ?? '—';
const releaseDate = rel.date ?? '—';
const apkSize = rel.apkSize ?? '—';
---

<Base title="Baixar AulaLogger — Android">
  <section class="px-6 py-16 max-w-3xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-bold mb-6">Baixar AulaLogger</h1>
    <p class="text-white/60 mb-8">
      Para Android 10 ou superior · 4 GB de RAM ou mais (recomendado para IA local)
    </p>

    <!-- Versão mais recente -->
    <div class="rounded-xl border border-bg-card bg-bg-secondary p-8 mb-6">
      <div class="flex items-start justify-between flex-wrap gap-4 mb-4">
        <div>
          <h2 class="text-2xl font-bold mb-1">Versão mais recente</h2>
          <p class="text-white/60 text-sm">
            {latestVersion} · {releaseDate} · {apkSize}
          </p>
        </div>
        {rel.prerelease && (
          <span
            class="rounded-full bg-warning/20 px-3 py-1 text-xs font-medium text-warning"
          >
            Pré-lançamento
          </span>
        )}
      </div>
      <p class="text-white/70 mb-6">
        APK assinado, publicado no GitHub Releases. Baixe, instale e comece a
        gravar suas aulas.
      </p>
      {hasDirect ? (
        <a href={rel.apkUrl} class="btn-primary inline-block">
          Baixar APK ({latestVersion})
        </a>
      ) : (
        <a
          href={latestPageUrl}
          class="btn-primary inline-block"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver versões no GitHub
        </a>
      )}
    </div>

    <!-- Outras formas -->
    <h2 class="text-2xl font-bold mb-4 mt-12">Outras formas de obter</h2>

    <div class="space-y-4">
      <a
        href={releasesUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-xl border border-bg-card bg-bg-secondary p-6 hover:border-accent transition"
      >
        <h3 class="font-semibold text-lg flex items-center gap-2">
          <span>🐙</span> GitHub Releases
        </h3>
        <p class="text-white/60 text-sm mt-2">
          Histórico completo de versões, incluindo betas e releases anteriores,
          com checksums SHA-256.
        </p>
      </a>

      <div class="block rounded-xl border border-bg-card bg-bg-secondary p-6 opacity-60">
        <h3 class="font-semibold text-lg flex items-center gap-2">
          <span>📦</span> F-Droid
        </h3>
        <p class="text-white/60 text-sm mt-2">
          Atualizações automáticas via loja open-source. Disponível após v1.2.
        </p>
      </div>
    </div>

    <!-- Como instalar APK -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold mb-6">Como instalar APK no Android</h2>
      <ol class="space-y-4 text-white/80">
        <li class="flex gap-4">
          <span class="flex-shrink-0 rounded-full bg-accent/20 text-accent w-8 h-8 flex items-center justify-center font-bold">
            1
          </span>
          <span>Baixe o APK do botão acima.</span>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 rounded-full bg-accent/20 text-accent w-8 h-8 flex items-center justify-center font-bold">
            2
          </span>
          <span>Abra "Configurações" do Android, vá em "Apps" ou "Segurança".</span>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 rounded-full bg-accent/20 text-accent w-8 h-8 flex items-center justify-center font-bold">
            3
          </span>
          <span>
            Procure "Instalar apps desconhecidos" e habilite para o navegador
            que você usou para baixar.
          </span>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 rounded-full bg-accent/20 text-accent w-8 h-8 flex items-center justify-center font-bold">
            4
          </span>
          <span>
            Abra o arquivo APK pela notificação de download ou pelo gerenciador
            de arquivos.
          </span>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 rounded-full bg-accent/20 text-accent w-8 h-8 flex items-center justify-center font-bold">
            5
          </span>
          <span>Aceite as permissões e pronto.</span>
        </li>
      </ol>

      <div class="mt-8 rounded-xl border border-warning/30 bg-warning/5 p-6">
        <p class="text-sm text-white/80">
          <strong class="text-warning">⚠️ Permissões importantes:</strong> a primeira vez que abrir,
          autorize <strong>microfone</strong>, <strong>notificações</strong> e
          <strong>ignorar otimização de bateria</strong>. Sem isso, gravações
          longas podem ser interrompidas pelo sistema.
        </p>
      </div>
    </div>
  </section>
</Base>
