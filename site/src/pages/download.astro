---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';

// Distribuição via GitHub Releases (resolve o limite de 25 MB do Cloudflare Pages).
const REPO = 'caioross/AulaLogger';
const releasesUrl = `https://github.com/${REPO}/releases`;
const latestPageUrl = `${releasesUrl}/latest`;

type Release = {
  version: string | null;
  date: string | null;
  apkUrl: string | null;
  apkSize: string | null;
  prerelease: boolean;
};

let rel: Release = {
  version: null,
  date: null,
  apkUrl: null,
  apkSize: null,
  prerelease: false,
};

// No momento do build, descobre a release mais recente e o nome do APK anexado.
// O link usa o redirect "releases/latest/download/<arquivo>", que o GitHub
// resolve sempre para a release mais nova — não fica desatualizado entre builds.
try {
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
    headers: {
      Accept: 'application/vnd.github+json',
      'User-Agent': 'aulalogger-site',
    },
  });
  if (res.ok) {
    const data = await res.json();
    const apk = (data.assets ?? []).find((a: any) =>
      a?.name?.toLowerCase().endsWith('.apk'),
    );
    rel = {
      version: data.tag_name ?? null,
      date: data.published_at
        ? new Date(data.published_at).toLocaleDateString('pt-BR')
        : null,
      apkUrl: apk ? `${latestPageUrl}/download/${apk.name}` : null,
      apkSize: apk?.size ? `${(apk.size / (1024 * 1024)).toFixed(0)} MB` : null,
      prerelease: Boolean(data.prerelease),
    };
  }
} catch {
  // Sem release publicada (ou API indisponível): cai no botão da página de releases.
}

const hasDirect = Boolean(rel.apkUrl);
const latestVersion = rel.version ?? 'v0.7.x';
const releaseDate = rel.date ?? '—';
const apkSize = rel.apkSize ?? '~52 MB';

const requirements = [
  { icon: 'smartphone', label: 'Android 10+', sub: 'API 29 ou superior' },
  { icon: 'cpu', label: '4 GB de RAM', sub: 'recomendado p/ transcrição' },
  { icon: 'mic', label: 'Microfone', sub: 'permissão obrigatória' },
  { icon: 'hard-drive', label: '~2 GB livres', sub: 'por aula de 4h (WAV)' },
];

const steps = [
  'Baixe o APK pelo botão acima.',
  'Abra as Configurações do Android e vá em "Apps" ou "Segurança".',
  'Ative "Instalar apps desconhecidos" para o navegador que você usou.',
  'Abra o APK pela notificação de download ou pelo gerenciador de arquivos.',
  'Conceda microfone, notificações e "ignorar otimização de bateria". Pronto!',
];
---

<Base
  title="Baixar AulaLogger para Android — APK grátis e open source"
  description="Baixe o APK do AulaLogger para Android 10+. Grátis, open source, sem Play Store. Grave e transcreva aulas direto no celular, offline."
>
  <section class="px-6 pt-16 pb-8">
    <div class="mx-auto max-w-3xl">
      <span class="eyebrow">Download</span>
      <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Baixar AulaLogger</h1>
      <p class="mt-4 text-white/60">
        Grátis, open source e sem Play Store. Instale o APK direto no seu Android e comece a gravar.
      </p>
    </div>
  </section>

  <section class="px-6 pb-6">
    <div class="mx-auto max-w-3xl">
      <!-- Card principal -->
      <div class="relative overflow-hidden rounded-3xl border border-accent/20 bg-gradient-to-br from-accent/[0.12] via-violet/[0.05] to-transparent p-8 shadow-glow">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-2xl font-bold">Versão mais recente</h2>
              {
                rel.prerelease && (
                  <span class="rounded-full bg-warning/20 px-3 py-1 text-xs font-medium text-warning">
                    Pré-lançamento
                  </span>
                )
              }
            </div>
            <p class="mt-1 font-mono text-sm text-white/55">
              {latestVersion} · {releaseDate} · {apkSize}
            </p>
          </div>
          <span class="badge"><Icon name="package" class="h-4 w-4 text-accent-soft" /> APK assinado</span>
        </div>
        <p class="mt-5 max-w-lg text-white/70">
          Publicado no GitHub Releases, com checksum SHA-256 para você verificar a integridade.
          Baixe, instale e grave sua próxima aula.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          {
            hasDirect ? (
              <a href={rel.apkUrl} class="btn-primary">
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                  <path d="M12 16l-5-5h3V4h4v7h3l-5 5zm-7 4h14v-2H5v2z" />
                </svg>
                Baixar APK ({latestVersion})
              </a>
            ) : (
              <a href={latestPageUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
                Ver versões no GitHub
              </a>
            )
          }
          <a href={latestPageUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">
            Notas da versão
          </a>
        </div>
      </div>

      <!-- Requisitos -->
      <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
        {
          requirements.map((r) => (
            <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-4 text-center">
              <div class="mx-auto grid h-10 w-10 place-items-center rounded-xl bg-accent/10 text-accent-soft">
                <Icon name={r.icon} class="h-5 w-5" />
              </div>
              <div class="mt-2.5 text-sm font-semibold text-white">{r.label}</div>
              <div class="text-xs text-white/45">{r.sub}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Outras formas -->
  <section class="px-6 py-10">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-xl font-bold tracking-tight">Outras formas de obter</h2>
      <div class="mt-5 space-y-3">
        <a
          href={releasesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="card flex items-start gap-4 !p-5"
        >
          <span class="grid h-10 w-10 flex-shrink-0 place-items-center rounded-xl bg-white/[0.05] text-white"><Icon name="github" class="h-5 w-5" /></span>
          <div>
            <h3 class="font-semibold">GitHub Releases</h3>
            <p class="mt-1 text-sm text-white/55">
              Histórico completo, betas e versões anteriores, com checksums SHA-256.
            </p>
          </div>
        </a>
        <div class="flex items-start gap-4 rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5 opacity-60">
          <span class="grid h-10 w-10 flex-shrink-0 place-items-center rounded-xl bg-white/[0.05] text-white"><Icon name="package" class="h-5 w-5" /></span>
          <div>
            <h3 class="font-semibold">F-Droid</h3>
            <p class="mt-1 text-sm text-white/55">
              Atualizações automáticas via loja open-source. Chega junto com o keystore de produção.
            </p>
          </div>
          <span class="ml-auto rounded-full bg-white/[0.05] px-2.5 py-1 text-xs text-white/45">em breve</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Como instalar -->
  <section class="px-6 py-10">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight">Como instalar o APK</h2>
      <ol class="mt-7 space-y-4">
        {
          steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="grid h-8 w-8 flex-shrink-0 place-items-center rounded-full bg-gradient-to-br from-accent to-violet text-sm font-bold text-white">
                {i + 1}
              </span>
              <span class="pt-1 text-white/80">{s}</span>
            </li>
          ))
        }
      </ol>

      <div class="mt-8 flex gap-4 rounded-2xl border border-warning/30 bg-warning/[0.06] p-6">
        <Icon name="alert-triangle" class="mt-0.5 h-5 w-5 flex-shrink-0 text-warning" />
        <p class="text-sm text-white/80">
          <strong class="text-warning">Permissões importantes:</strong> na primeira abertura,
          autorize <strong>microfone</strong>, <strong>notificações</strong> e
          <strong>ignorar otimização de bateria</strong>. Sem isso, alguns fabricantes
          (Xiaomi, Samsung, Huawei) podem interromper gravações longas em segundo plano.
        </p>
      </div>
    </div>
  </section>
</Base>
