---
import Icon from '@/components/Icon.astro';

const links = [
  { href: '/', label: 'Início' },
  { href: '/download', label: 'Baixar' },
  { href: '/docs', label: 'Documentação' },
  { href: '/changelog', label: 'Changelog' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-white/[0.06] bg-bg-primary/70 backdrop-blur-xl"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2.5" aria-label="AulaLogger — início">
      <span
        class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-accent to-violet shadow-glow transition-transform group-hover:scale-105"
      >
        <Icon name="mic" class="h-5 w-5 text-white" />
      </span>
      <span class="text-lg font-bold tracking-tight">AulaLogger</span>
    </a>

    <!-- Navegação desktop -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegação principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'relative text-sm transition hover:text-white',
              isActive(l.href) ? 'text-white' : 'text-white/60',
            ]}
          >
            {l.label}
            {isActive(l.href) && (
              <span class="absolute -bottom-1.5 left-0 h-px w-full bg-gradient-to-r from-accent to-violet" />
            )}
          </a>
        ))
      }
      <a
        href="https://github.com/caioross/AulaLogger"
        class="flex items-center gap-1.5 text-sm text-white/60 transition hover:text-white"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Repositório no GitHub"
      >
        <Icon name="github" class="h-[18px] w-[18px]" />
        GitHub
      </a>
      <a href="/download" class="btn-primary !px-5 !py-2 text-sm">Baixar</a>
    </nav>

    <!-- Botão menu mobile -->
    <button
      id="menu-btn"
      type="button"
      class="menu-btn flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 text-white/80 transition hover:bg-white/5 md:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="icon-open"><Icon name="menu" class="h-5 w-5" /></span>
      <span class="icon-close"><Icon name="x" class="h-5 w-5" /></span>
    </button>
  </div>

  <!-- Painel mobile -->
  <nav
    id="mobile-menu"
    class="mobile-menu absolute left-0 top-full w-full overflow-hidden border-b border-white/[0.06] bg-bg-primary/95 backdrop-blur-xl md:hidden"
    aria-label="Navegação mobile"
  >
    <div class="flex flex-col gap-1 px-6 pb-6 pt-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-lg px-3 py-3 text-base transition hover:bg-white/5',
              isActive(l.href) ? 'text-white' : 'text-white/70',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="https://github.com/caioross/AulaLogger"
        class="flex items-center gap-2 rounded-lg px-3 py-3 text-base text-white/70 transition hover:bg-white/5"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="github" class="h-[18px] w-[18px]" /> GitHub
      </a>
      <a href="/download" class="btn-primary mt-2 w-full">Baixar para Android</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const setOpen = (state: boolean) => {
      btn.setAttribute('aria-expanded', String(state));
      btn.setAttribute('aria-label', state ? 'Fechar menu' : 'Abrir menu');
      btn.classList.toggle('is-open', state);
      menu.classList.toggle('is-open', state);
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false)),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!menu.contains(t) && !btn.contains(t)) setOpen(false);
    });
  }
</script>
