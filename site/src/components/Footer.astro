---
import Icon from '@/components/Icon.astro';
const year = new Date().getFullYear();

const cols = [
  {
    title: 'Produto',
    links: [
      { href: '/download', label: 'Baixar', external: false },
      { href: '/docs', label: 'Documentação', external: false },
      { href: '/changelog', label: 'Changelog', external: false },
    ],
  },
  {
    title: 'Comunidade',
    links: [
      { href: 'https://github.com/caioross/AulaLogger', label: 'GitHub', external: true },
      { href: 'https://github.com/caioross/AulaLogger/issues', label: 'Issues', external: true },
      { href: 'https://github.com/caioross/AulaLogger/discussions', label: 'Discussions', external: true },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacidade', external: false },
      { href: '/terms', label: 'Termos', external: false },
      { href: 'https://github.com/caioross/AulaLogger/blob/main/SECURITY.md', label: 'Segurança', external: true },
    ],
  },
];
---

<footer class="relative mt-24 border-t border-white/[0.06]">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-5">
      <!-- Marca -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-accent to-violet shadow-glow">
            <Icon name="mic" class="h-5 w-5 text-white" />
          </span>
          <span class="text-lg font-bold tracking-tight">AulaLogger</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/55">
          Grave, transcreva e analise suas aulas — inteiro no seu celular, sem nuvem.
          Feito com cuidado para quem dá muito de si em cada aula.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="badge !text-xs"><Icon name="lock" class="h-3.5 w-3.5 text-success" /> Sem telemetria</span>
          <span class="badge !text-xs"><Icon name="scale" class="h-3.5 w-3.5 text-accent-soft" /> GPL-3.0</span>
        </div>
      </div>

      {
        cols.map((col) => (
          <div>
            <h3 class="mb-3 text-sm font-semibold text-white">{col.title}</h3>
            <ul class="space-y-2.5 text-sm">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-white/55 transition hover:text-accent-soft"
                    {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-white/[0.06] pt-8 text-xs text-white/40 md:flex-row md:items-center"
    >
      <p>© {year} AulaLogger · Open source sob licença GPL-3.0.</p>
      <p>Seu áudio nunca sai do seu celular.</p>
    </div>
  </div>
</footer>
