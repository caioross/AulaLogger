---
const year = new Date().getFullYear();
---

<footer class="border-t border-bg-card mt-24">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
      <div>
        <h3 class="font-semibold text-white mb-3">Produto</h3>
        <ul class="space-y-2 text-white/60">
          <li><a href="/download" class="hover:text-accent transition">Baixar</a></li>
          <li><a href="/docs" class="hover:text-accent transition">Documentação</a></li>
          <li><a href="/changelog" class="hover:text-accent transition">Changelog</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-white mb-3">Comunidade</h3>
        <ul class="space-y-2 text-white/60">
          <li><a href="https://github.com/<usuario>/aulalogger" class="hover:text-accent transition">GitHub</a></li>
          <li><a href="https://github.com/<usuario>/aulalogger/issues" class="hover:text-accent transition">Issues</a></li>
          <li><a href="https://github.com/<usuario>/aulalogger/discussions" class="hover:text-accent transition">Discussions</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-white mb-3">Legal</h3>
        <ul class="space-y-2 text-white/60">
          <li><a href="/privacy" class="hover:text-accent transition">Privacidade</a></li>
          <li><a href="/terms" class="hover:text-accent transition">Termos</a></li>
          <li><a href="/security" class="hover:text-accent transition">Segurança</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-white mb-3">Sobre</h3>
        <ul class="space-y-2 text-white/60">
          <li>Open source · GPL-3.0</li>
          <li>Sem coleta de dados</li>
          <li>Sem propaganda</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-bg-card flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-white/40">
      <p>© {year} AulaLogger. Open source sob licença GPL-3.0.</p>
      <p>Feito com cuidado para professores que dão muito de si.</p>
    </div>
  </div>
</footer>
